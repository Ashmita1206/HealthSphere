# ====================================================
# HealthSphere Development Environment (.env.development)
# ====================================================

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=healthsphere-dev-secret-key-32-chars-long-local
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=dev-cookie-secret
CORS_ORIGIN=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/healthsphere
REDIS_URL=redis://localhost:6379

# AI Services (Fallback mock will activate if key is omitted)
GEMINI_API_KEY=
AI_PROVIDER=mock
AI_MODEL=mock-model

# Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Logging
LOG_LEVEL=debug
