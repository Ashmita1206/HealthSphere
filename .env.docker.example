# ====================================================
# HealthSphere AI — Docker Environment Template
# ====================================================

# Deployment Profile
NODE_ENV=production
PORT=4000
VITE_API_URL=http://localhost:4000

# Database & Cache URLs
MONGODB_URI=mongodb://mongodb:27017/healthsphere
REDIS_URL=redis://redis:6379

# Security & Credentials
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
CLIENT_URL=http://localhost,http://localhost:80,http://localhost:5173

# Logging
LOG_LEVEL=info

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Cloudinary (Reports & Media)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
