# ====================================================
# HealthSphere Production Docker Environment Template
# Copy to .env.docker or pass to docker-compose
# ====================================================

# -----------------
# Core Server Configuration
# -----------------
NODE_ENV=production
PORT=4000
CLIENT_URL=http://localhost

# -----------------
# Security & Authentication
# -----------------
# Generate a strong 64-character random string for production
JWT_SECRET=healthsphere-change-me-to-a-secure-random-64-char-string-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# -----------------
# Database & Cache (Docker Network)
# -----------------
MONGODB_URI=mongodb://mongodb:27017/healthsphere
MONGO_INITDB_DATABASE=healthsphere
REDIS_URL=redis://redis:6379

# -----------------
# AI Clinical Services (Optional / Fallback Available)
# -----------------
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-latest

# -----------------
# Cloud Storage (Optional / Local Fallback Available)
# -----------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------
# Frontend Build Arguments
# -----------------
VITE_API_URL=/api
VITE_SOCKET_URL=/
