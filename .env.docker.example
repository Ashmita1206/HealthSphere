# ====================================================
# HealthSphere Enterprise AI — Docker Environment Template
# Copy to .env.docker or pass to docker-compose
# ====================================================

# -----------------
# Core Server Configuration & Deployment Profile
# -----------------
NODE_ENV=production
PORT=4000
CLIENT_URL=http://localhost,http://localhost:80,http://localhost:5173

# -----------------
# Security & Authentication
# -----------------
# Generate a cryptographically strong 64-character random string for production
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# -----------------
# Database & Cache (Docker Network)
# -----------------
MONGODB_URI=mongodb://mongodb:27017/healthsphere
MONGO_INITDB_DATABASE=healthsphere
REDIS_URL=redis://redis:6379

# -----------------
# Logging
# -----------------
LOG_LEVEL=info

# -----------------
# AI Clinical Services (Optional / Fallback Available)
# -----------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-latest

# -----------------
# Cloud Storage (Reports & Media Vault)
# -----------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# -----------------
# Frontend Build Arguments
# -----------------
VITE_API_URL=/api
VITE_SOCKET_URL=/
