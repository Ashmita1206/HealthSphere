# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Backend
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/healthsphere
JWT_SECRET=change_me_to_a_long_secure_secret
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Twilio Programmable Messaging (Emergency SOS SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_STATUS_CALLBACK_URL=http://localhost:4000/api/emergency/twilio/status-callback

