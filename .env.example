# =========================================
# 🌍 HealthSphere Environment Variables
# =========================================
# Copy this file to `.env` and replace values
# DO NOT commit your actual `.env` file
# =========================================


# =========================================
# 🔐 Supabase Configuration (Required)
# =========================================
# Get from: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key


# =========================================
# 🗺️ Google Maps API (Optional)
# =========================================
# Used for location/map features
# Get from: Google Cloud Console → APIs & Credentials

VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key


# =========================================
# 🤖 AI / Backend Keys (IMPORTANT)
# =========================================
# These should NOT be stored in frontend `.env`
# Configure them securely in backend / Supabase Edge Functions

# LOVABLE_API_KEY=configure_in_backend_only


# =========================================
# ⚠️ Security Notes
# =========================================
# 1. Never commit real API keys to GitHub
# 2. Add `.env` to `.gitignore`
# 3. Rotate keys immediately if exposed
# 4. Use environment-specific configs for production
