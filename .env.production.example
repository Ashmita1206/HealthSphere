# ====================================================
# HealthSphere Production Environment (.env.production)
# ====================================================

NODE_ENV=production
PORT=4000
CLIENT_URL=https://healthsphere.example.com

# Authentication & Security
JWT_SECRET=production-super-secret-key-min-64-characters-long-example-healthsphere
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=production-cookie-secret-encryption-key-healthsphere
CORS_ORIGIN=https://healthsphere.example.com

# Database & Cache
MONGODB_URI=mongodb://mongodb:27017/healthsphere
REDIS_URL=redis://redis:6379

# AI Services
GEMINI_API_KEY=your_production_gemini_api_key
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-latest

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate Limiting & Monitoring
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
LOG_LEVEL=info
